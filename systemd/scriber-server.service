[Unit]
Description=Scriber speech-to-text server (NeMo Parakeet)
After=graphical-session.target
Wants=graphical-session.target

[Service]
Type=simple
WorkingDirectory=%h/Projects/scriber/scriber-server
ExecStart=%h/Projects/scriber/scriber-server/.venv/bin/scriber-server
Restart=on-failure
RestartSec=5
Environment=PYTORCH_CUDA_ALLOC_CONF=expandable_segments:True

[Install]
WantedBy=default.target
